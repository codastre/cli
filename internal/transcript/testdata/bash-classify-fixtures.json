{
  "_comment": "Bash command -> class. Shared verbatim between codastre-claude adapters/claude/hooks/test/ and codastre cli/internal/transcript/testdata/; the hook (lib.js) and the transcript collector (classify.go) must agree on every row. Edit both copies together.",
  "cases": [
    {"command": "grep -rn \"foo\" src", "class": "text-search"},
    {"command": "cd x && rg 'a|b'", "class": "text-search"},
    {"command": "git grep -n foo", "class": "text-search"},
    {"command": "ls | xargs grep foo", "class": "text-search"},
    {"command": "find . -name '*.go'", "class": "text-search"},
    {"command": "echo it\\'s; grep x f", "class": "text-search"},
    {"command": "bash -c 'grep -rn x .'", "class": "text-search"},
    {"command": "sh -lc \"rg foo\"", "class": "text-search"},
    {"command": "eval 'grep x f'", "class": "text-search"},
    {"command": "echo \"$(grep -c x f)\"", "class": "text-search"},
    {"command": "echo \"`rg x`\"", "class": "text-search"},
    {"command": "echo \"$(grep \"x y\" f)\"", "class": "text-search"},
    {"command": "bash <<'EOF'\ngrep x f\nEOF", "class": "text-search"},
    {"command": "cat <<EOF > notes.txt\nhello\nEOF\ngrep x notes.txt", "class": "text-search"},

    {"command": "git commit -m \"fix (grep/rg/ag) handling\"", "class": "other"},
    {"command": "git commit -q -m 'feat: classify (grep|rg) exits; rg too'", "class": "other"},
    {"command": "git commit -F - <<'EOF'\nfeat: (grep|rg) exits\n; rg foo\nEOF", "class": "other"},
    {"command": "python3 - <<'EOF'\nimport os\nos.system(\"grep x f\")\nEOF", "class": "other"},
    {"command": "echo \"; rg foo\"", "class": "other"},
    {"command": "gh pr create --title \"x\" --body \"steps: (grep foo) then | rg bar\"", "class": "other"},
    {"command": "printf '%s\\n' '| grep x'", "class": "other"},
    {"command": "git status", "class": "other"},

    {"command": "cat src/a.go | grep foo", "class": "text-search"},
    {"command": "sed -n 1,90p record.go | rg -n json: | head -40", "class": "text-search"},
    {"command": "ls docs | rg -i metric", "class": "text-search"},
    {"command": "find . -type f | grep _test", "class": "text-search"},
    {"command": "git ls-files | grep _test.go", "class": "text-search"},
    {"command": "./test.sh 2>&1 | tail -5; rg -n foo Sources", "class": "text-search"},
    {"command": "if grep -q x f; then echo y; fi", "class": "text-search"},
    {"command": "cd /w && sed -n 1,10p a.go; rg -n Foo src | head", "class": "text-search"},

    {"command": "security find-generic-password -s codastre -a host 2>&1 | rg -c acct", "class": "other"},
    {"command": "codastre doctor 2>&1 | rg -i \"auth|keychain\" | head", "class": "other"},
    {"command": "git log --oneline | grep fix", "class": "other"},
    {"command": "ps aux | grep node", "class": "other"},
    {"command": "go test ./... 2>&1 | grep FAIL", "class": "other"},
    {"command": "make build |& grep error", "class": "other"},
    {"command": "for a in x y; do echo \"== $a\"; security find-generic-password -a \"$a\" 2>&1 | rg -c acct; done", "class": "other"},
    {"command": "./build.sh 2>&1 | tail -3", "class": "other"},
    {"command": "cat <<EOF > notes.txt\nhello\nEOF", "class": "other"},
    {"command": "sed -i '' 's/a/b/' Makefile", "class": "other"},
    {"command": "cat a.go > b.go", "class": "other"},
    {"command": "git diff | head -50", "class": "other"},

    {"command": "sed -n 1,120p Sources/a.swift", "class": "read"},
    {"command": "cd /w && sed -n 80,141p a.go; sed -n 1,10p b.go", "class": "read"},
    {"command": "cat README.md", "class": "read"},
    {"command": "head -50 server/main.py 2>/dev/null", "class": "read"},
    {"command": "tail -n 20 build.log", "class": "read"},
    {"command": "ls cli/internal; wc -l a.go; sed -n 1,60p ~/.config/codastre/config.json", "class": "read"},
    {"command": "cat state.json | jq .sessions", "class": "read"},

    {"command": "codastre query \"grep usages\" --format agent", "class": "codastre"},
    {"command": "codastre query \"x\" --top-k 6 | grep foo", "class": "codastre"},
    {"command": "~/go/bin/codastre graph Foo --direction inbound", "class": "codastre"},
    {"command": "codastre corpora \"ticket text\" --top-k 5", "class": "codastre"},
    {"command": "codastre contracts --kind kafka", "class": "codastre"},
    {"command": "git commit -m \"run codastre query x first\"", "class": "other"}
  ]
}
